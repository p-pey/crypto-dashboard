# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# ---------------------------------------------------------------- #
# Cloud AI providers - all have a free tier
#
# The analysis page and the coin-status narrative can both use these.
# Order of preference is local runtime, then Gemini, then Groq, then
# OpenRouter, so a local model wins while one is loaded and the first key
# set takes over when it is not.
#
# Rates change often. Check the live page for the quota that applies today.
# ---------------------------------------------------------------- #

# Gemini -> https://aistudio.google.com/apikey
#   Most generous free tier of the three. Best default if you only add one.
GEMINI_API_KEY=""
# Groq -> https://console.groq.com/keys
#   Very fast, and the most restrictive free tier. Good when latency matters.
GROQ_API_KEY=""
# OpenRouter -> https://openrouter.ai/keys
#   Uses a ":free" routed model by default; many models, thinner quota.
OPENROUTER_API_KEY=""

# Pin one provider instead of following the order above.
# One of: local, gemini, groq, openrouter
# AI_PROVIDER=""

# Optional model overrides. Leave unset to use the provider's default free model.
STATUSES_GEMINI_MODEL=""
STATUSES_GROQ_MODEL=""
STATUSES_OPENROUTER_MODEL=""
STATUSES_SITE_URL=""

# Base for Gemini, if you front it with a proxy.
GEMINI_BASE_URL=""

# Shared secret for POST /api/cron/statuses (leave empty to disable the check)
CRON_SECRET=""

# ---------------------------------------------------------------- #
# Local LLM - LM Studio or Ollama
#
# The analysis page can hand its scorecard to a model running on this
# machine and render the answer. Nothing is sent off the box: there is no
# cloud provider and no fallback in this path. Leave it unset and the page
# keeps its deterministic forecast.
#
# Both runtimes speak the same OpenAI dialect, so they are configured the
# same way - only the port differs. See docs/local-llm.md.
# ---------------------------------------------------------------- #

# LM Studio (Developer -> Local Server) listens on 1234.
# Ollama (ollama serve) listens on 11434. Uncomment the line for whichever
# you run. `/v1` is appended when missing, so a bare host is fine.
LOCAL_LLM_BASE_URL="http://127.0.0.1:1234"
# LOCAL_LLM_BASE_URL="http://127.0.0.1:11434"

# Model id to use. Unset takes the first model the runtime lists, which is
# fine with LM Studio but not with Ollama - pin it there, or you may get a
# 1B model or an embedding model instead of the one you meant.
LOCAL_LLM_MODEL=""

# Only needed if the local server was started with auth enabled. Ollama's
# local server ignores it and LM Studio has no auth by default.
LOCAL_LLM_API_KEY=""

# Deprecated aliases, still read so an existing .env keeps working.
# LOCAL_LLM_* wins when both are set.
# LMSTUDIO_BASE_URL=""
# LMSTUDIO_MODEL=""
# LMSTUDIO_API_KEY=""

# ---------------------------------------------------------------- #
# Trading
# ---------------------------------------------------------------- #

# `paper` simulates every fill against the live order book and never sends an
# order anywhere. `live` sends real orders and real money. Flip this only after
# paper has behaved correctly for a while.
TRADING_MODE="paper"

# Required by every trading endpoint, because this app has no sign-in flow.
# Generate one with: openssl rand -hex 32
# Leave empty to disable trading entirely.
TRADING_API_SECRET=""

# SQLite file holding the paper ledger, the notification outbox and the
# arbitrage alert rules. Live orders are read from the exchange itself.
TRADING_DB_PATH="./.data/trading.sqlite"

# ---------------------------------------------------------------- #
# Exchange credentials
#
# Every credential is optional. A venue with no credential reports itself
# unconfigured and its trade buttons are hidden, rather than the app failing
# to boot. Get keys from each venue's web panel under API settings.
# ---------------------------------------------------------------- #

# Nobitex -> Profile -> Settings -> API -> token. Sent as `Authorization: Token`.
# Valid 30 days when "remember me" is ticked; otherwise 4 hours.
NOBITEX_TOKEN=""
# Point at the exchange's own testnet while developing:
# NOBITEX_BASE_URL="https://testnetapiv2.nobitex.ir"

# Wallex -> panel -> API. Expires on the date chosen at creation; there is no
# refresh, so rotation means minting a new key.
WALLEX_API_KEY=""

# Bitpin -> settings -> API. These are exchanged for a short-lived JWT at
# runtime. Note Bitpin has no leverage product at all.
BITPIN_API_KEY=""
BITPIN_SECRET_KEY=""

# Tabdeal -> tabdeal.org/panel/settings/api. Requests are HMAC-SHA256 signed.
TABDEAL_API_KEY=""
TABDEAL_API_SECRET=""

# BitUnix -> bitunix.com -> API. Double SHA-256 signed, no testnet exists.
BITUNIX_API_KEY=""
BITUNIX_SECRET_KEY=""

# ---------------------------------------------------------------- #
# Telegram notifications
#
# Create a bot with @BotFather and get the chat id by messaging it once.
# Both are required for notifications; without them everything else still
# works and the app simply stays quiet.
# ---------------------------------------------------------------- #

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
